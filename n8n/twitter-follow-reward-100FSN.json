        "options": {},
        "bodyParametersJson": "={\n  \"fields\": {\n    \"uid\": { \"stringValue\": \"{{$json.fields.email.stringValue}}\" },\n    \"title\": { \"stringValue\": \"🎉 Twitter Reward\" },\n    \"body\": { \"stringValue\": \"لقد حصلت على 100 FSN لمتابعتنا على تويتر!\" },\n    \"timestamp\": { \"timestampValue\": \"{{ new Date().toISOString() }}\" },\n    \"read\": { \"booleanValue\": false },\n    \"claimed\": { \"booleanValue\": true }\n  }\n}"
