{
  "name": "Verify Tweet Banner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "verify-tweet",
        "options": {}
      },
      "id": "http_trigger",
      "name": "Webhook - Tweet Verification",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.twitter.com/2/users/by/username={{$json[\"twitter\"]}}",
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.TWITTER_BEARER_TOKEN }}"
            }
          ]
        }
      },
      "id": "get_user_id",
      "name": "Get Twitter User ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.twitter.com/2/users/{{$node[\"Get Twitter User ID\"].json[\"data\"].id}}/tweets?max_results=5",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.TWITTER_BEARER_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get_tweets",
      "name": "Fetch Recent Tweets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "{{$json[\"data\"][0].text}}",
              "operation": "contains",
              "value2": "https://2u.pw/Np639"
            },
            {
              "value1": "{{$json[\"data\"][0].text}}",
              "operation": "contains",
              "value2": "@fsncrew"
            }
          ]
        }
      },
      "id": "check_tweet",
      "name": "Check Tweet Content",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { success: true, message: '✅ تم التحقق من التغريدة بنجاح.' } }];"
      },
      "id": "success_msg",
      "name": "✅ Valid Tweet",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { success: false, message: '❌ التغريدة لا تحتوي على المعلومات المطلوبة.' } }];"
      },
      "id": "fail_msg",
      "name": "❌ Invalid Tweet",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1400, 400]
    }
  ],
  "connections": {
    "Webhook - Tweet Verification": {
      "main": [
        [
          {
            "node": "Get Twitter User ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Twitter User ID": {
      "main": [
        [
          {
            "node": "Fetch Recent Tweets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Tweets": {
      "main": [
        [
          {
            "node": "Check Tweet Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Tweet Content": {
      "main": [
        [
          {
            "node": "✅ Valid Tweet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "❌ Invalid Tweet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
