{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twitter-follow-reward",
        "options": {}
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://api.twitter.com/2/users/by/username={{$json[\"twitterUsername\"]}}",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_TWITTER_BEARER_TOKEN"
            }
          ]
        }
      },
      "id": "GetTwitterUserId",
      "name": "Get Twitter User ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://firestore.googleapis.com/v1/projects/flysky-site/databases/(default)/documents/users/{$json[\"uid\"]}",
        "authentication": "none"
      },
      "id": "GetUser",
      "name": "Get User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json[\"fields\"][\"twitterFollowReward\"][\"booleanValue\"]}}",
              "operation": "notEqual",
              "value2": "true"
            }
          ]
        }
      },
      "id": "CheckRewardGiven",
      "name": "Already Rewarded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://firestore.googleapis.com/v1/projects/flysky-site/databases/(default)/documents/users/{$node[\"Webhook\"].json[\"uid\"]}?updateMask.fieldPaths=balance&updateMask.fieldPaths=twitterFollowReward",
        "authentication": "headerAuth",
        "requestMethod": "PATCH",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "{\"fields\": {\"balance\": {\"integerValue\": \"={{parseInt($json[\\\"fields\\\"][\\\"balance\\\"][\\\"integerValue\\\"])+100}}\"}, \"twitterFollowReward\": {\"booleanValue\": true}}}"
      },
      "id": "UpdateUser",
      "name": "Update User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "responseData": "\u2705 \u062a\u0645 \u0645\u0646\u062d \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629 \u0628\u0646\u062c\u0627\u062d",
        "responseCode": 200
      },
      "id": "SuccessResponse",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          "GetTwitterUserId"
        ]
      ]
    },
    "GetTwitterUserId": {
      "main": [
        [
          "GetUser"
        ]
      ]
    },
    "GetUser": {
      "main": [
        [
          "CheckRewardGiven"
        ]
      ]
    },
    "CheckRewardGiven": {
      "main": [
        [
          "UpdateUser",
          "true"
        ]
      ]
    },
    "UpdateUser": {
      "main": [
        [
          "SuccessResponse"
        ]
      ]
    }
  },
  "name": "Twitter Follow Reward - REST",
