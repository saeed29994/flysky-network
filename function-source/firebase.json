{
  "functions": {
    "source": ".",  // <== النقطة تعني الجذر (مجلد fsn-functions)
    "predeploy": ["npm run build"]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
