# Firebase Configuration
# These are PUBLIC keys and safe to expose in client-side code
# Firebase security is handled by Firestore Security Rules and Authentication

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_WEB_APP_ID=your_web_app_id

# Firebase Mobile App IDs (for Capacitor)
VITE_FIREBASE_ANDROID_APP_ID=your_android_app_id
VITE_FIREBASE_IOS_APP_ID=your_ios_app_id

# Firebase VAPID Key (for web push notifications)
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# RevenueCat API Keys (for in-app purchases)
VITE_REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_key
VITE_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_key

# Development/Production Environment
VITE_NODE_ENV=development
